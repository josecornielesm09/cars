        "p",
        { className: "footer-legal" },
        "Financiamiento mediante compañías financieras, sujeto a aprobación de crédito. Car Haus LLC no es Buy Here Pay Here y no ofrece financiamiento en casa. Precio, garantía, millaje, año, tipo de título y disponibilidad cambian según la unidad; confirma las condiciones de la camioneta que te interesa antes de comprar."
      ),
      e("p", { className: "footer-copy" }, "© " + new Date().getFullYear() + " Car Haus LLC · Pharr, Texas")
    );
  }

  /* ==========================================================================
     Aplicación
     ========================================================================== */
  function App() {
    var initialIndex = React.useMemo(function () {
      for (var i = 0; i < vehicles.length; i++) if (vehicles[i].featured && vehicles[i].available !== false) return i;
      return 0;
    }, []);

    var idxState = React.useState(initialIndex);
    var index = idxState[0], setIndex = idxState[1];

    /* turn = vueltas acumuladas del anillo. index se deriva de turn, así el
       giro conserva la dirección del gesto aunque se salte de la 5 a la 1. */
    var turnState = React.useState(0);
    var turn = turnState[0], setTurn = turnState[1];

    var menuState = React.useState(false);
    var menuOpen = menuState[0], setMenuOpen = menuState[1];

    var rebuiltState = React.useState(false);
    var rebuiltOpen = rebuiltState[0], setRebuiltOpen = rebuiltState[1];

    var pauseState = React.useState(false);
    var paused = pauseState[0], setPaused = pauseState[1];

    var vehicle = vehicles[index];
    var activeSlot = ((turn % vehicles.length) + vehicles.length) % vehicles.length;

    var menuBtnRef = React.useRef(null);
    var stageRef = React.useRef(null);
    var heroRef = React.useRef(null);
    var wheelLock = React.useRef(0);
    var touch = React.useRef(null);
    var pointer = React.useRef({ x: 0, y: 0, raf: null });
    var washRef = React.useRef(null);
    var haloRef = React.useRef(null);
    var cameraRef = React.useRef(null);
    var copyRef = React.useRef(null);

    var goTo = React.useCallback(function (target, method) {
      var total = vehicles.length;
      var t = ((target % total) + total) % total;
      if (t === index) return;
      var current = ((turn % total) + total) % total;
      var forward = (t - current + total) % total;      // pasos hacia adelante
      var backward = (current - t + total) % total;     // pasos hacia atrás
      var step = forward <= backward ? forward : -backward;
      setTurn(turn + step);
      setIndex(t);
      setRebuiltOpen(false);
      track("vehicle_navigation", vehicles[t], { method: method || "unknown" });
    }, [index, turn]);

    var next = React.useCallback(function (m) { goTo(index + 1, m); }, [goTo, index]);
    var prev = React.useCallback(function (m) { goTo(index - 1, m); }, [goTo, index]);

    React.useEffect(function () { track("vehicle_view", vehicle); }, [vehicle.id]);

    /* --- Rueda: una unidad por gesto, debounce de 80 ms.
           No secuestra el scroll si la ventana no alcanza para la interfaz. --- */
    React.useEffect(function () {
      /* Solo mientras el hero ocupa la pantalla: más abajo el scroll es normal
         y la página completa se recorre como cualquier otra. */
      function canHijack() {
        if (window.innerWidth <= 960 || window.innerHeight < 660) return false;
        var hero = heroRef.current;
        if (!hero) return false;
        var r = hero.getBoundingClientRect();
        return r.top >= -8 && r.bottom > window.innerHeight * 0.9;
      }
      function onWheel(ev) {
        if (menuOpen || !canHijack()) return;
        var d = Math.abs(ev.deltaY) >= Math.abs(ev.deltaX) ? ev.deltaY : ev.deltaX;
        if (Math.abs(d) < 6) return;
        ev.preventDefault();
        var now = Date.now();
        if (now - wheelLock.current < 80 + 620) return; // debounce + duración de la transición
        wheelLock.current = now;
        setPaused(true);
        if (d > 0) next("wheel"); else prev("wheel");
      }
      window.addEventListener("wheel", onWheel, { passive: false });
      return function () { window.removeEventListener("wheel", onWheel); };
    }, [next, prev, menuOpen]);

    /* --- Teclado --- */
    React.useEffect(function () {
      function onKey(ev) {
        if (menuOpen) return;
        if (ev.key === "ArrowRight" || ev.key === "ArrowDown") { ev.preventDefault(); setPaused(true); next("keyboard"); }
        else if (ev.key === "ArrowLeft" || ev.key === "ArrowUp") { ev.preventDefault(); setPaused(true); prev("keyboard"); }
      }
      window.addEventListener("keydown", onKey);
      return function () { window.removeEventListener("keydown", onKey); };
    }, [next, prev, menuOpen]);

    /* --- Auto-rotación cada 6 s; se pausa con interacción, menú o motion reducido --- */
    React.useEffect(function () {
      if (!CONFIG.autoRotateMs || paused || menuOpen || reduceMotion()) return;
      var t = window.setTimeout(function () { next("auto"); }, CONFIG.autoRotateMs);
      return function () { window.clearTimeout(t); };
    }, [index, paused, menuOpen, next]);

    /* --- Paralaje por puntero: solo desktop, sin state por movimiento --- */
    React.useEffect(function () {
      if (reduceMotion()) return;
      function onMove(ev) {
        if (window.innerWidth <= 960) return;
        pointer.current.x = (ev.clientX / window.innerWidth - 0.5) * 2;
        pointer.current.y = (ev.clientY / window.innerHeight - 0.5) * 2;
        if (pointer.current.raf) return;
        pointer.current.raf = window.requestAnimationFrame(function () {
          pointer.current.raf = null;
          var x = pointer.current.x, y = pointer.current.y;
          if (washRef.current) washRef.current.style.transform = "translate3d(" + x * 6 + "px," + y * 6 + "px,0)";
          if (haloRef.current) haloRef.current.style.transform =
            "translate3d(calc(-50% + " + x * 12 + "px), calc(-50% + " + y * 12 + "px), -90px)";
          /* La cámara se inclina: el piso, el anillo y el fondo se mueven
             en profundidad, no solo en píxeles. */
          if (cameraRef.current) cameraRef.current.style.transform =
            "rotateX(" + (-y * 2.2) + "deg) rotateY(" + (x * 3.4) + "deg) translate3d(" + x * 14 + "px,0,0)";
          if (copyRef.current) copyRef.current.style.transform = "translate3d(" + x * 4 + "px," + y * 4 + "px,0)";
        });
      }
      window.addEventListener("mousemove", onMove);
      return function () {
        window.removeEventListener("mousemove", onMove);
        if (pointer.current.raf) window.cancelAnimationFrame(pointer.current.raf);
      };
    }, []);

    /* --- Swipe horizontal con umbral, sin bloquear el scroll vertical --- */
    function onTouchStart(ev) {
      var t = ev.touches[0];
      touch.current = { x: t.clientX, y: t.clientY };
      setPaused(true);
    }
    function onTouchEnd(ev) {
      if (!touch.current) return;
      var t = ev.changedTouches[0];
      var dx = t.clientX - touch.current.x;
      var dy = t.clientY - touch.current.y;
      touch.current = null;
      if (Math.abs(dx) < 56 || Math.abs(dx) < Math.abs(dy) * 1.3) return;
      if (dx < 0) next("swipe"); else prev("swipe");
    }

    function closeMenu() {
      setMenuOpen(false);
      if (menuBtnRef.current) menuBtnRef.current.focus();
    }

    var sold = vehicle.available === false;
    var facts = factsFor(vehicle);
    var badges = badgesFor(vehicle, { compact: true });
    var waHref = whatsappUrl(vehicle);

    /* --- CTAs reutilizados en el hero y en la barra fija móvil --- */
    function whatsappCta(label, source) {
      return e(
        "a",
        {
          className: "cta cta--whatsapp",
          href: sold ? undefined : waHref,
          target: "_blank",
          rel: "noopener noreferrer",
          "aria-disabled": sold ? "true" : undefined,
          tabIndex: sold ? -1 : undefined,
          onClick: function () { if (!sold) track("whatsapp_click", vehicle, { source: source }); }
        },
        e(IconWhatsapp, null),
        label
      );
    }
    function callCta(label, source) {
      return e(
        "a",
        {
          className: "cta cta--call",
          href: CONFIG.phoneHref,
          onClick: function () { track("phone_click", vehicle, { source: source }); }
        },
        e(IconPhone, null),
        label
      );
    }

    /* Barra de revoluciones: marca cuánto se ha recorrido de la página.
       Se actualiza con requestAnimationFrame, sin estado de React. */
    var rpmRef = React.useRef(null);
    React.useEffect(function () {
      if (reduceMotion()) return;
      var raf = null;
      function paint() {
        raf = null;
        var doc = document.documentElement;
        var max = doc.scrollHeight - window.innerHeight;
        var p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
        if (rpmRef.current) rpmRef.current.style.transform = "scaleX(" + p + ")";
      }
      function onScroll() { if (!raf) raf = window.requestAnimationFrame(paint); }
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll);
      paint();
      return function () {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
        if (raf) window.cancelAnimationFrame(raf);
      };
    }, []);

    /* Lleva una unidad al escenario desde el inventario de abajo. */
    function showInStage(i) {
      goTo(i, "inventario");
      setPaused(true);
      if (heroRef.current && heroRef.current.scrollIntoView) {
        heroRef.current.scrollIntoView({ behavior: reduceMotion() ? "auto" : "smooth", block: "start" });
      }
    }

    return e(
      React.Fragment,
      null,
      e("div", { className: "scroll-rpm", ref: rpmRef, "aria-hidden": "true" }),
      e(
      "div",
      { className: "carhaus-app", ref: heroRef },

      /* ---------- Fondo ---------- */
      e(
        "div",
        { className: "backdrop", "aria-hidden": "true" },
        e("div", { className: "backdrop-wash", ref: washRef }),
        e("div", { className: "backdrop-haze" }),
        e("div", { className: "vignette" }),
        e(Snow, null)
      ),

      /* ---------- Header ---------- */
      e(
        "header",
        { className: "carhaus-header" },
        e(
          "div",
          { className: "brand" },
          e("img", { className: "brand-mark", src: CONFIG.logo, alt: "Car Haus LLC", width: 120, height: 120 }),
          e(
            "div",
            null,
            e("span", { className: "brand-name" }, "Car Haus"),
            e("span", { className: "brand-meta" }, "Pharr · Rio Grande Valley")
          )
        ),
        e("p", { className: "specialty" }, "Especialistas en Toyota Tacoma"),
        e(
          "button",
          {
            type: "button",
            className: "menu-button",
            ref: menuBtnRef,
            "aria-haspopup": "dialog",
            "aria-expanded": menuOpen ? "true" : "false",
            "aria-label": "Abrir menú",
            onClick: function () { setPaused(true); setMenuOpen(true); }
          },
          e("i", null), e("i", null), e("i", null)
        )
      ),

      /* ---------- Escenario ---------- */
      e(
        "main",
        {
          className: "inventory-stage",
          ref: stageRef,
          onMouseEnter: function () { setPaused(true); },
          onMouseLeave: function () { setPaused(false); },
          onFocus: function () { setPaused(true); },
          onTouchStart: onTouchStart,
          onTouchEnd: onTouchEnd
        },

        e("div", { className: "copy-scrim", "aria-hidden": "true" }),
        e("div", { className: "nav-scrim", "aria-hidden": "true" }),

        e(
          "article",
          { className: "vehicle-slide" },

          /* ----- Texto ----- */
          e(
            "section",
            { className: "vehicle-copy", ref: copyRef },
            e("p", { className: "eyebrow" }, "Tacomas disponibles en Pharr, Texas"),
            e(
              "h1",
              { className: "vehicle-title" },
              "Tu próxima",
              e("span", { className: "line-2" }, "Tacoma")
            ),
            e("div", { className: "title-rule" }),

            e(
              "div",
              { className: "copy-swap" },
              e(
                TransitionGroup,
                { component: null },
                e(
                  CSSTransition,
                  { key: vehicle.id, classNames: "copy", timeout: 660 },
                  e(
                    "div",
                    null,
                    e(
                      "h2",
                      { className: "vehicle-subtitle", "aria-live": "polite" },
                      e("span", { className: "subtitle-year" }, vehicle.year),
                      "Toyota Tacoma ",
                      e("span", { className: "trim" }, trimLine(vehicle))
                    ),
                    e(
                      "p",
                      { className: "vehicle-desc" },
                      "Lista para el trabajo, la aventura o el uso diario. Conoce su historial, condiciones y opciones de financiamiento antes de decidir."
                    ),
                    vehicle.highlights && vehicle.highlights.length
                      ? e(
                          "ul",
                          { className: "equipment" },
                          vehicle.highlights.slice(0, 5).map(function (h, i) { return e("li", { key: i }, h); })
                        )
                      : null,
                    ready(vehicle.titleDisclosure)
                      ? e("p", { className: "title-note" }, vehicle.titleDisclosure)
                      : null
                  )
                )
              )
            ),

            /* Badges condicionales */
            e(
              "div",
              { style: { position: "relative" } },
              e(
                TransitionGroup,
                { component: null },
                e(
                  CSSTransition,
                  { key: vehicle.id, classNames: "badges", timeout: 560 },
                  e(
                    "ul",
                    { className: "badges" },
                    badges.map(function (b) {
                      if (b.action) {
                        return e(
                          "li",
                          { key: b.key },
                          e(
                            "button",
                            {
                              type: "button",
                              className: "badge badge--action",
                              "aria-expanded": rebuiltOpen ? "true" : "false",
                              "aria-controls": "rebuilt-panel",
                              onClick: function () {
                                var opening = !rebuiltOpen;
                                setRebuiltOpen(opening);
                                setPaused(true);
                                if (opening) track("rebuilt_info_open", vehicle);
                              }
                            },
                            b.text
                          )
                        );
                      }
                      return e(
                        "li",
                        { key: b.key },
                        e("span", { className: "badge" + (b.sold ? " badge--sold" : "") }, b.text)
                      );
                    })
                  )
                )
              )
            ),

            rebuiltOpen
              ? e(
                  "div",
                  { className: "rebuilt-panel", id: "rebuilt-panel", role: "region", "aria-label": "Qué significa un título rebuilt" },
                  e("b", null, "Título rebuilt. "),
                  "Indica que el vehículo fue reparado después de haber sido declarado pérdida total. En Car Haus te explicamos el historial y las reparaciones para que sepas exactamente qué estás comprando."
                )
              : null,

            e(
              "div",
              { className: "cta-row" },
              whatsappCta("Cotizar por WhatsApp", "hero"),
              callCta("Llamar al " + CONFIG.phoneDisplay, "hero")
            ),
            e(
              "p",
              { className: "cta-note" },
              sold
                ? "Esta unidad ya se vendió. Escríbenos y te avisamos cuando entre una parecida."
                : "Financiamiento mediante financieras, sujeto a aprobación de crédito. No somos Buy Here Pay Here."
            )
          ),

          /* ----- Escena 3D ----- */
          e(
            "section",
            { className: "vehicle-visual" },
            e(
              "div",
              { className: "scene" },
              e(
              "div",
              { className: "camera", ref: cameraRef },

              e("div", { className: "floor", "aria-hidden": "true" }),
              e("div", { className: "floor-edge", "aria-hidden": "true" }),
              e("div", { className: "beam", "aria-hidden": "true" }),
              e("div", { className: "halo", ref: haloRef, "aria-hidden": "true" }),

              /* Año de la unidad activa, al fondo del escenario */
              e(
                TransitionGroup,
                { component: null },
                e(
                  CSSTransition,
                  { key: vehicle.id, classNames: "year", timeout: 820 },
                  e("div", { className: "ghost-year", "aria-hidden": "true" }, vehicle.year)
                )
              ),

              /* Carrusel: las cinco unidades sobre una circunferencia.
                 turn avanza o retrocede sin límite, así el giro siempre
                 sigue la dirección del gesto.                            */
              e(
                "div",
                { className: "ring", style: { "--turn": turn } },
                vehicles.map(function (v, i) {
                  var total = vehicles.length;
                  var d = (i - activeSlot + total) % total;
                  var depth = Math.min(d, total - d); // 0 = al frente, 2 = al fondo
                  return e(
                    "div",
                    {
                      key: v.id,
                      className: "slot",
                      "data-depth": depth,
                      "aria-hidden": depth === 0 ? undefined : "true",
                      style: { "--i": i }
                    },
                    e(
                      "div",
                      { className: "slot-face", style: { "--turn": turn } },
                      e("div", { className: "contact-shadow" }),
                      e(UnitPhoto, { vehicle: v, priority: i === initialIndex, decorative: depth !== 0 })
                    )
                  );
                })
              ),

              /* Datos comerciales */
              e(
                "div",
                { className: "facts-slot" },
                e(
                  TransitionGroup,
                  { component: null },
                  e(
                    CSSTransition,
                    { key: vehicle.id, classNames: "facts", timeout: 660 },
                    e(
                      "ul",
                      { className: "vehicle-facts" },
                      facts.map(function (f) {
                        return e(
                          "li",
                          { key: f.key },
                          e(
                            "span",
                            { className: "fact-value" },
                            typeof f.count === "number"
                              ? e(
                                  React.Fragment,
                                  null,
                                  f.prefix || "",
                                  e(Counter, { value: f.count }),
                                  f.suffix ? e("span", { className: "unit-suffix" }, f.suffix) : null
                                )
                              : f.text
                          ),
                          e("span", { className: "fact-label" }, f.label)
                        );
                      })
                    )
                  )
                )
              )
              )
            )
          )
        ),

        /* ----- Navegación ----- */
        e(
          "nav",
          { className: "vehicle-navigation", "aria-label": "Unidades disponibles" },
          vehicles.map(function (v, i) {
            return e(
              "button",
              {
                key: v.id,
                type: "button",
                className: "nav-item",
                "aria-current": i === index ? "true" : "false",
                onClick: function () { setPaused(true); goTo(i, "nav"); }
              },
              v.available === false ? e("span", { className: "nav-sold" }, "Vendida") : null,
              e("span", { className: "nav-year" }, isRepeatedTrim(v) ? v.year : ""),
              e("span", null, shortName(v))
            );
          }),
          e(
            "div",
            { className: "nav-arrows" },
            e("button", {
              type: "button", className: "nav-arrow", "aria-label": "Unidad anterior",
              onClick: function () { setPaused(true); prev("arrow"); }
            }, "←"),
            e("button", {
              type: "button", className: "nav-arrow", "aria-label": "Unidad siguiente",
              onClick: function () { setPaused(true); next("arrow"); }
            }, "→")
          ),
          e(
            "p",
            { className: "scroll-hint", "aria-hidden": "true" },
            e("span", { className: "scroll-mouse" }),
            "Rueda o flechas"
          )
        )
      ),

      /* ---------- Franja de confianza ---------- */
      e(
        "aside",
        { className: "trust-band", "aria-label": "Por qué comprar en Car Haus" },
        e(
          "ul",
          { className: "trust-strip" },
          e("li", null, "Vehículos inspeccionados"),
          e("li", null, "Tipo de título a la vista"),
          e("li", null, "Financiamiento con crédito aprobado"),
          e(
            "li",
            { className: "strip-address" },
            e(
              "a",
              {
                href: CONFIG.mapsUrl,
                target: "_blank",
                rel: "noopener noreferrer",
                onClick: function () { track("location_click", vehicle, { source: "strip" }); }
              },
              CONFIG.address
            )
          )
        )
      ),

      ),

      /* ---------- Landing ---------- */
      e(
        "main",
        { className: "landing" },
        e(BrandTicker, null),
        e(InventorySection, { onShow: showInStage }),
        e(GallerySection, null),
        e(TrustSection, null),
        e(HowToSection, null),
        e(RebuiltSection, null),
        e(LocationSection, { vehicle: vehicle })
      ),

      e(SiteFooter, null),

      /* ---------- CTA fijo móvil ---------- */
      e(
        "div",
        { className: "sticky-cta" },
        whatsappCta("WhatsApp", "sticky"),
        callCta("Llamar", "sticky")
      ),

      /* ---------- Menú ---------- */
      e(
        TransitionGroup,
        { component: null },
        menuOpen
          ? e(
              CSSTransition,
              { key: "menu", classNames: "menu", timeout: 420 },
              e(MenuPanel, {
                vehicle: vehicle,
                onClose: closeMenu,
                onNavigate: function (hash) {
                  closeMenu();
                  var target = document.querySelector(hash);
                  if (target && target.scrollIntoView) {
                    target.scrollIntoView({ behavior: reduceMotion() ? "auto" : "smooth", block: "start" });
                  }
                }
              })
            )
          : null
      )
    );
  }

  ReactDOM.render(e(App, null), document.getElementById("root"));
})();
