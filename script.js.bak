  /* Carrusel horizontal: scroll nativo con imanes, flechas y barra de avance.
     En móvil se desliza con el dedo sin JavaScript de por medio. */
  function useCarousel() {
    var trackRef = React.useRef(null);
    var st = React.useState({ progress: 0, atStart: true, atEnd: false });
    var state = st[0], setState = st[1];

    var measure = React.useCallback(function () {
      var el = trackRef.current;
      if (!el) return;
      var max = el.scrollWidth - el.clientWidth;
      var p = max > 4 ? el.scrollLeft / max : 0;
      setState({ progress: p, atStart: el.scrollLeft <= 4, atEnd: max - el.scrollLeft <= 4 });
    }, []);

    React.useEffect(function () {
      var el = trackRef.current;
      if (!el) return;
      measure();
      el.addEventListener("scroll", measure, { passive: true });
      window.addEventListener("resize", measure);
      return function () {
        el.removeEventListener("scroll", measure);
        window.removeEventListener("resize", measure);
      };
    }, [measure]);

    function step(dir) {
      var el = trackRef.current;
      if (!el) return;
      var card = el.firstChild;
      var amount = card ? card.getBoundingClientRect().width + 18 : el.clientWidth * 0.8;
      el.scrollBy({ left: dir * amount, behavior: reduceMotion() ? "auto" : "smooth" });
    }

    return { ref: trackRef, state: state, step: step };
  }

  function CarouselControls(props) {
    return e(
      "div",
      { className: "rail-controls" },
      e(
        "div",
        { className: "rail-progress", "aria-hidden": "true" },
        e("span", { style: { transform: "scaleX(" + Math.max(0.06, props.progress) + ")" } })
      ),
      e(
        "div",
        { className: "rail-arrows" },
        e(
          "button",
          {
            type: "button", className: "rail-arrow",
            "aria-label": "Ver anteriores", disabled: props.atStart,
            onClick: function () { props.step(-1); }
          },
          "←"
        ),
        e(
          "button",
          {
            type: "button", className: "rail-arrow",
            "aria-label": "Ver siguientes", disabled: props.atEnd,
            onClick: function () { props.step(1); }
          },
          "→"
        )
      )
    );
  }

  /* Cinta de marcas y versiones: se repite dos veces para que el bucle
     no tenga costura. Se detiene al pasar el cursor y con motion reducido. */
  function BrandTicker() {
