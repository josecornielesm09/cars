  var gallery = [];

  /* ==========================================================================
     Utilidades
     ========================================================================== */

  /* Un campo pendiente nunca llega al visitante. */
  function ready(value) {
    if (value === null || value === undefined) return false;
    var s = String(value).trim();
    return s !== "" && s.toLowerCase() !== "actualizar";
  }

  function reduceMotion() {
    return !!(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches);
  }

  function thousands(n) {
    return String(Math.round(n)).replace(/\B(?=(\d{3})+(?!\d))/g, ",");
  }

  /* Nombre corto para la navegación; el año desempata versiones repetidas. */
  function shortName(v) {
    return v.trim.toUpperCase();
  }
  function isRepeatedTrim(v) {
    var n = 0;
    for (var i = 0; i < vehicles.length; i++) if (vehicles[i].trim === v.trim) n++;
    return n > 1;
  }

  function trimLine(v) {
    return v.trim + (ready(v.drivetrain) ? " · " + v.drivetrain : "");
  }

  function altText(v) {
    return (
      v.year + " " + v.make + " " + v.model + " " + v.trim +
      (ready(v.drivetrain) ? " " + v.drivetrain : "") +
      (ready(v.color) ? " color " + v.color.toLowerCase() : "") +
      " en Car Haus LLC, Pharr, Texas"
    );
  }

  function whatsappUrl(v) {
    var msg =
      "Hola, vi la " + v.year + " Toyota Tacoma " + v.trim +
      (ready(v.drivetrain) ? " " + v.drivetrain : "") +
      " en la página de Car Haus. ¿Sigue disponible? Quiero conocer precio, down payment y requisitos.";
    return "https://wa.me/" + CONFIG.whatsappNumber + "?text=" + encodeURIComponent(msg);
  }

  /* dataLayer: parámetros de la unidad activa, nunca datos personales. */
  function track(name, v, extra) {
    if (!window.dataLayer || typeof window.dataLayer.push !== "function") return;
    var payload = { event: name };
    if (v) {
      payload.vehicle_id = v.id;
      payload.vehicle_year = v.year;
      payload.vehicle_trim = v.trim;
      payload.vehicle_drivetrain = v.drivetrain || "";
    }
    if (extra) for (var k in extra) if (Object.prototype.hasOwnProperty.call(extra, k)) payload[k] = extra[k];
    window.dataLayer.push(payload);
  }

  /* ==========================================================================
     Datos comerciales visibles: precio y garantía solo si están confirmados.
     ========================================================================== */
  function factsFor(v) {
    var out = [];
    if (ready(v.price)) {
      out.push({ key: "price", count: Number(String(v.price).replace(/[^0-9.]/g, "")), prefix: "$", label: "Precio" });
    }
    out.push({ key: "trim", text: trimLine(v).toUpperCase(), label: "Versión" });
    if (ready(v.warranty)) {
      out.push({ key: "warranty", text: "3 meses", label: "Motor · transmisión · A/C" });
    }
    if (out.length < 3 && typeof v.mileage === "number") {
      out.push({ key: "mileage", count: v.mileage, suffix: "MI", label: "Millaje" });
    }
    if (out.length < 3 && ready(v.engine)) {
      out.push({ key: "engine", text: v.engine.toUpperCase(), label: "Motor" });
    }
    return out.slice(0, 3);
  }

  function badgesFor(v, options) {
    var list = [{ key: "inspected", text: "Inspeccionada" }];
    if (ready(v.warranty)) list.push({ key: "warranty", text: "Garantía 3 meses" });
    if (!options || !options.compact) list.push({ key: "finance", text: "Financiamiento disponible" });
    if (ready(v.titleType) && v.titleType.toLowerCase() === "rebuilt") {
      list.push({ key: "rebuilt", text: "Título rebuilt", action: true });
    }
    if (v.promotionActive && ready(v.promotion)) list.push({ key: "promo", text: "Promo: " + v.promotion });
    if (v.available === false) list.push({ key: "sold", text: "Vendida", sold: true });
    return list;
  }

  /* ==========================================================================
     Contador numérico — requestAnimationFrame + BezierEasing(0.4,-0.7,0.1,1.5)
     ========================================================================== */
  var easeOvershoot =
    typeof BezierEasing === "function" ? BezierEasing(0.4, -0.7, 0.1, 1.5) : function (t) { return t; };

  function Counter(props) {
    var target = props.value;
    var st = React.useState(reduceMotion() ? target : 0);
    var value = st[0], setValue = st[1];

    React.useEffect(function () {
      if (reduceMotion()) { setValue(target); return; }
      var raf = null, start = null, dur = 1100;
      function step(ts) {
        if (start === null) start = ts;
        var p = Math.min(1, (ts - start) / dur);
        setValue(Math.max(0, target * easeOvershoot(p)));
        if (p < 1) raf = window.requestAnimationFrame(step);
      }
      raf = window.requestAnimationFrame(step);
      return function () { if (raf) window.cancelAnimationFrame(raf); };
    }, [target]);

    return thousands(value);
  }
  Counter.propTypes = { value: PropTypes.number.isRequired };

  /* ==========================================================================
     Nieve fina: la atmósfera del logo, no partículas genéricas
     ========================================================================== */
  function Snow() {
    var flakes = React.useMemo(function () {
      var a = [];
      for (var i = 0; i < 18; i++) {
        a.push({ left: (i * 5.7 + 3) % 100, delay: (i % 9) * 1.4, dur: 13 + (i % 6) * 3.4, size: i % 3 === 0 ? 3 : 2 });
      }
      return a;
    }, []);
    return e(
      "div",
      { className: "snow", "aria-hidden": "true" },
      flakes.map(function (f, i) {
        return e("i", {
          key: i,
          style: {
            left: f.left + "%",
            width: f.size + "px",
            height: f.size + "px",
            animationDelay: f.delay + "s",
            animationDuration: f.dur + "s"
          }
        });
      })
    );
  }

  /* ==========================================================================
     Iconos
     ========================================================================== */
  function IconWhatsapp() {
    return e(
      "svg",
      { viewBox: "0 0 24 24", "aria-hidden": "true", focusable: "false", fill: "currentColor" },
