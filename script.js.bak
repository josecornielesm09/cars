      { viewBox: "0 0 24 24", "aria-hidden": "true", focusable: "false", fill: "currentColor" },
      e("path", {
        d: "M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.4.6 3.6.6.6 0 1 .5 1 1V20c0 .6-.4 1-1 1C10.7 21 3 13.3 3 4c0-.6.5-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.4 0 .8-.2 1l-2.3 2.2Z"
      })
    );
  }

  /* ==========================================================================
     Fotografía de la unidad + reflejo real sobre el piso
     ========================================================================== */
  function UnitPhoto(props) {
    var v = props.vehicle;
    var decorative = !!props.decorative;
    var st = React.useState(false);
    var failed = st[0], setFailed = st[1];

    if (failed) {
      // Nunca se carga una imagen externa de reemplazo.
      return e("div", { className: "photo-pending" }, "Foto de unidad pendiente");
    }

    var styleVars = {
      "--contact": v.frame ? v.frame.contact : 0.72,
      "--scale": v.frame ? v.frame.scale : 1
    };

    return e(
      React.Fragment,
      null,
      e("img", {
        className: "unit-mirror",
        src: v.image,
        alt: "",
        "aria-hidden": "true",
        width: 500,
        height: 500,
        style: styleVars,
        draggable: false
      }),
      e("img", {
        className: "unit-photo",
        src: v.image,
        alt: decorative ? "" : altText(v),
        "aria-hidden": decorative ? "true" : undefined,
        width: 500,
        height: 500,
        style: styleVars,
        loading: props.priority ? "eager" : "lazy",
        decoding: "async",
        draggable: false,
        onError: function () { setFailed(true); }
      })
    );
  }
  UnitPhoto.propTypes = { vehicle: PropTypes.object.isRequired, priority: PropTypes.bool, decorative: PropTypes.bool };

  /* ==========================================================================
     Menú
     ========================================================================== */
  function MenuPanel(props) {
    var panelRef = React.useRef(null);

    React.useEffect(function () {
      function onKey(ev) { if (ev.key === "Escape") props.onClose(); }
      document.addEventListener("keydown", onKey);
      var first = panelRef.current && panelRef.current.querySelector("button, a");
      if (first) first.focus();
      return function () { document.removeEventListener("keydown", onKey); };
    }, []);

    /* El menú navega a secciones reales de la página, nunca a páginas ficticias. */
    var sections = [
      { hash: "#inventario", label: "Inventario", hint: vehicles.length + " Tacomas" },
      { hash: "#como-comprar", label: "Cómo comprar", hint: "4 pasos" },
      { hash: "#requisitos", label: "Requisitos", hint: "Documentos" },
      { hash: "#por-que", label: "Garantía", hint: "Según la unidad" },
      { hash: "#titulos", label: "Títulos rebuilt", hint: "Qué significan" },
      { hash: "#ubicacion", label: "Ubicación", hint: "Pharr, TX" }
    ];

    return e(
      "div",
      {
        className: "menu-overlay",
        onMouseDown: function (ev) { if (ev.target === ev.currentTarget) props.onClose(); }
      },
      e(
        "div",
        { className: "menu-panel", role: "dialog", "aria-modal": "true", "aria-label": "Menú de Car Haus", ref: panelRef },
        e(
          "div",
          { className: "menu-head" },
          e(
            "div",
            null,
            e("h2", { className: "menu-title" }, "Car Haus"),
            e("p", { className: "menu-subtitle" }, "Pharr, Texas")
          ),
          e("button", { type: "button", className: "menu-close", onClick: props.onClose, "aria-label": "Cerrar menú" }, "✕")
        ),

        sections.map(function (item) {
          return e(
            "button",
            {
              key: item.hash,
              type: "button",
              className: "menu-link",
              onClick: function () { props.onNavigate(item.hash); }
            },
            item.label,
            e("span", null, item.hint)
          );
        }),

        e(
          "a",
          { className: "menu-link", href: CONFIG.facebookUrl, target: "_blank", rel: "noopener noreferrer" },
          "Facebook",
          e("span", null, "@Carhaus2021")
        ),

        e(
          "a",
          {
            className: "menu-link",
            href: whatsappUrl(props.vehicle),
            target: "_blank",
            rel: "noopener noreferrer",
            onClick: function () { track("whatsapp_click", props.vehicle, { source: "menu" }); }
          },
          "WhatsApp",
          e("span", null, CONFIG.phoneDisplay)
        ),

        e(
          "div",
          { className: "menu-foot" },
          e("b", null, "Visítanos"),
          e("p", { style: { margin: "0 0 6px" } }, CONFIG.address),
          e("p", { style: { margin: "0 0 6px" } }, "Teléfono y WhatsApp: " + CONFIG.phoneDisplay),
          e("p", { style: { margin: "0 0 6px" } }, CONFIG.email),
          e("p", { style: { margin: 0 } }, "Atendemos Pharr, McAllen, Mission, Edinburg, Harlingen y todo el Rio Grande Valley.")
        )
      )
    );
  }
  MenuPanel.propTypes = {
    vehicle: PropTypes.object.isRequired,
    onClose: PropTypes.func.isRequired,
    onNavigate: PropTypes.func.isRequired
  };


  /* ==========================================================================
     Secciones de la landing
     --------------------------------------------------------------------------
     Contenido tomado de la página pública de Car Haus en Facebook
     (facebook.com/Carhaus2021): descripción del negocio, años de experiencia,
     teléfono, WhatsApp, correo, dirección y valoración. Nada inventado.
     ========================================================================== */

  /* Revela cada sección al entrar en pantalla, sin librerías. */
  function useReveal() {
    var ref = React.useRef(null);
    React.useEffect(function () {
      var node = ref.current;
      if (!node) return;
      if (reduceMotion() || typeof IntersectionObserver === "undefined") {
        node.setAttribute("data-visible", "true");
        return;
      }
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          if (en.isIntersecting) {
            en.target.setAttribute("data-visible", "true");
            io.unobserve(en.target);
          }
        });
      }, { threshold: 0.16 });
      io.observe(node);
      return function () { io.disconnect(); };
    }, []);
    return ref;
  }

  /* Trazo de marcador: el mismo gesto que hacen sobre el parabrisas. */
  function MarkerCircle() {
    return e(
      "svg",
      { className: "figure-mark", viewBox: "0 0 120 90", preserveAspectRatio: "none", "aria-hidden": "true", focusable: "false" },
      e("path", { d: "M96 12C80 4 44 2 24 12 4 22 2 52 14 68c12 16 52 20 76 12 22-8 30-30 24-46" })
    );
  }

  /* Marco hexagonal de las flechas del escaparate. */
  function HexFrame() {
    return e(
      "svg",
      { className: "hex-frame", viewBox: "0 0 100 112", "aria-hidden": "true", focusable: "false" },
      e("path", {
        d: "M50 2 L96 29 L96 83 L50 110 L4 83 L4 29 Z",
        fill: "none", stroke: "currentColor", strokeWidth: "2"
      })
    );
  }

  /* Tacómetro: la aguja barre una vez cuando la sección entra en pantalla.
     El arco mide 240 unidades; en reposo queda a tres cuartos. */
  function Tachometer() {
    var ticks = [];
    for (var t = 0; t <= 8; t++) {
      var a = (-138 + t * 24) * Math.PI / 180;
      var r1 = t % 2 === 0 ? 62 : 68;
      ticks.push(
        e("line", {
          key: t,
          className: "tach-tick",
          x1: 100 + Math.cos(a) * r1, y1: 92 + Math.sin(a) * r1,
          x2: 100 + Math.cos(a) * 76, y2: 92 + Math.sin(a) * 76
        })
      );
    }
    return e(
      "div",
      { className: "tach" },
      e(
        "svg",
        {
          className: "tach-dial", viewBox: "0 0 200 116",
          style: { "--arc-len": 240, "--arc-rest": 72 },
          "aria-hidden": "true", focusable: "false"
        },
        e("path", { className: "tach-arc", d: "M24 92 A 76 76 0 0 1 176 92" }),
