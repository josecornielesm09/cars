  /* -------------------------------- Inventario ----------------------------
     Escaparate: una unidad por pantalla, se desliza en horizontal.
     Las pestañas filtran por tracción sin sacar ninguna unidad del carril.
     ------------------------------------------------------------------------ */
  function InventorySection(props) {
    var ref = useReveal();
    var car = useCarousel();

    var filterState = React.useState("todas");
    var filter = filterState[0], setFilter = filterState[1];

    var tabs = React.useMemo(function () {
      var found = [];
      vehicles.forEach(function (v) {
        if (ready(v.drivetrain) && found.indexOf(v.drivetrain) === -1) found.push(v.drivetrain);
      });
      return [{ id: "todas", label: "Todas" }].concat(
        found.map(function (d) { return { id: d, label: d }; })
      );
    }, []);

    var shown = vehicles.filter(function (v) {
      return filter === "todas" || v.drivetrain === filter;
    });

    /* Al cambiar de pestaña el carril vuelve al principio. */
    React.useEffect(function () {
      if (car.ref.current) car.ref.current.scrollLeft = 0;
    }, [filter]);

    var index = Math.min(shown.length - 1, Math.round(car.state.progress * (shown.length - 1)));

    return e(
      "section",
      { className: "showcase", id: "inventario", ref: ref },

      e(
        "header",
        { className: "showcase-head" },
        e(
          "div",
          null,
          e("p", { className: "section-eyebrow" }, "Inventario"),
          e("h2", { className: "showcase-title" }, "Las Tacomas que hay en piso")
        ),
        e(
          "div",
          { className: "showcase-tabs", role: "tablist", "aria-label": "Filtrar por tracción" },
          tabs.map(function (t) {
            return e(
              "button",
              {
                key: t.id,
                type: "button",
                role: "tab",
                className: "showcase-tab",
                "aria-selected": filter === t.id ? "true" : "false",
                onClick: function () { setFilter(t.id); }
              },
              t.label
            );
          })
        )
      ),

      e(
        "ul",
        {
          className: "showcase-track",
          ref: car.ref,
          tabIndex: 0,
          role: "group",
          "aria-label": "Unidades disponibles"
        },
        shown.map(function (v) {
          var sold = v.available === false;
          var realIndex = vehicles.indexOf(v);
          return e(
            "li",
            { key: v.id, className: "slide" + (sold ? " slide--sold" : "") },

            e(
              "header",
              { className: "slide-head" },
              e("span", { className: "slide-year" }, v.year),
              e(
                "h3",
                { className: "slide-name" },
                "Tacoma ",
                e("span", null, v.trim + (ready(v.drivetrain) ? " · " + v.drivetrain : ""))
              )
            ),

            e(
              "div",
              { className: "slide-stage" },
              e("span", { className: "slide-glow", "aria-hidden": "true" }),
              e("span", { className: "slide-floor", "aria-hidden": "true" }),
              e(
                "span",
                {
                  className: "slide-figure",
                  /* Recorta el margen transparente del PNG justo bajo las
                     llantas, usando la línea de contacto ya medida. */
                  style: {
                    "--top": Math.max(0, (v.frame && v.frame.top ? v.frame.top : 0.24) - 0.035),
                    "--cut": (v.frame ? v.frame.contact : 0.72) + 0.045
                  }
                },
                e("img", {
                  className: "slide-photo",
                  src: v.image,
                  alt: altText(v),
                  width: 500, height: 500,
                  loading: "lazy", decoding: "async", draggable: false
                })
              )
            ),

            e(
              "ul",
              { className: "slide-specs" },
              typeof v.mileage === "number"
                ? e("li", { key: "mi" }, e("b", null, thousands(v.mileage) + " mi"), e("span", null, "Millaje"))
                : null,
              ready(v.engine) ? e("li", { key: "en" }, e("b", null, v.engine), e("span", null, "Motor")) : null,
              ready(v.cab) ? e("li", { key: "cab" }, e("b", null, v.cab), e("span", null, "Cabina")) : null,
              ready(v.titleType) ? e("li", { key: "ti" }, e("b", null, v.titleType), e("span", null, "Título")) : null,
              ready(v.price) ? e("li", { key: "pr" }, e("b", null, v.price), e("span", null, "Precio")) : null
            ),

            e(
              "div",
              { className: "slide-links" },
              e(
                "button",
                { type: "button", className: "line-link", onClick: function () { props.onShow(realIndex); } },
                "Verla en el escenario"
              ),
              sold
                ? e("span", { className: "line-link line-link--sold" }, "Vendida")
                : e(
                    "a",
                    {
                      className: "line-link",
                      href: whatsappUrl(v),
                      target: "_blank",
                      rel: "noopener noreferrer",
                      onClick: function () { track("whatsapp_click", v, { source: "escaparate" }); }
                    },
                    "Cotizar por WhatsApp"
                  ),
              e(
                "a",
                {
                  className: "line-link",
                  href: CONFIG.phoneHref,
                  onClick: function () { track("phone_click", v, { source: "escaparate" }); }
                },
                "Llamar"
              )
            )
          );
        })
      ),

      /* Flechas hexagonales a los costados, como en la referencia */
      e(
        "button",
        {
          type: "button", className: "hex-arrow hex-arrow--prev",
          "aria-label": "Unidad anterior", disabled: car.state.atStart,
          onClick: function () { car.step(-1); }
        },
        e(HexFrame, null),
        e("span", { className: "hex-glyph" }, "‹")
      ),
      e(
        "button",
        {
          type: "button", className: "hex-arrow hex-arrow--next",
          "aria-label": "Unidad siguiente", disabled: car.state.atEnd,
          onClick: function () { car.step(1); }
        },
        e(HexFrame, null),
        e("span", { className: "hex-glyph" }, "›")
      ),

      e(
        "div",
        { className: "showcase-foot" },
        e(
          "p",
          { className: "showcase-count" },
          e("b", null, ("0" + (index + 1)).slice(-2)),
          e("i", null, "/"),
          ("0" + shown.length).slice(-2)
        ),
        e(
          "div",
          { className: "rail-progress", "aria-hidden": "true" },
          e("span", { style: { transform: "scaleX(" + Math.max(0.08, car.state.progress) + ")" } })
        ),
        e(
          "p",
          { className: "showcase-hint" },
          "Desliza o usa las flechas"
        )
      )
    );
  }

